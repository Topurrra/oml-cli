       "outputs": [
        "Customer"
       ]
      },
      {
       "kind": "aggregate",
       "name": "SomeOrders",
       "sources": [
        "Order"
       ],
       "maxRecords": 20
      },
      {
       "kind": "assign",
       "name": "CountRows",
       "assign": {
        "Rows": "TopCustomers.List.Length + SomeOrders.List.Length"
       }
      }
     ]
    }
   ],
   "widgets": [
    {
     "type": "Expression",
     "value": "GetPage.Count"
    },
    {
     "type": "Expression",
     "value": "LoadSql.Rows"
    }
