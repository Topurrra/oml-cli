    "base": "seed", "spec": { "clientActions": [
      { "name": "Fact", "function": true, "inputs": [{ "name": "N", "type": "Integer" }], "outputs": [{ "name": "Result", "type": "Integer", "default": "1" }],
        "locals": [{ "name": "I", "type": "Integer", "default": "1" }], "flow": [
        { "kind": "if", "name": "More", "condition": "I <= N", "true": "Step", "false": "End" },
        { "kind": "assign", "name": "Step", "assign": { "Result": "Result * I", "I": "I + 1" }, "next": "More" } ] },
      { "name": "ValidateTotal", "inputs": [{ "name": "Total", "type": "Decimal" }], "outputs": [{ "name": "IsValid", "type": "Boolean", "default": "False" }],
        "flow": [{ "kind": "assign", "assign": { "IsValid": "Total >= 0" } }] } ] } },
