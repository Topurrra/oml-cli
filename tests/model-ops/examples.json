      { "kind": "assign", "assign": { "Text": "Js.Out" } } ] }] } },
  { "id": "server-action-exception", "examples": ["AddServerActionWithException.cs", "AddServerActionWithStatusTransition.cs"],
    "base": "seed", "spec": { "serverActions": [{ "name": "ApproveOrder", "inputs": [{ "name": "OrderId", "type": "Order Identifier" }],
      "locals": [{ "name": "Rec", "type": "Order" }], "flow": [
      { "kind": "execute", "name": "Load", "action": "GetOrderForUpdate", "args": { "Id": "OrderId" } },
      { "kind": "if", "name": "IsOpen", "condition": "Load.Record.Order.StatusId = Entities.Status.Open", "true": "Close", "false": "NotOpen" },
      { "kind": "assign", "name": "Close", "assign": { "Rec": "Load.Record.Order", "Rec.StatusId": "Entities.Status.Closed" } },
      { "kind": "execute", "action": "UpdateOrder", "args": { "Source": "Rec" }, "next": "End" },
      { "kind": "raiseException", "name": "NotOpen", "exception": "InvalidOrder", "message": "\"Only open orders can be approved\"" } ] }] } },
  { "id": "server-action-foreach-json", "examples": ["AddServerActionWithForEach.cs"],
    "base": "seed", "spec": { "serverActions": [{ "name": "ImportRows", "inputs": [{ "name": "Json", "type": "Text" }],
      "outputs": [{ "name": "Sum", "type": "Decimal" }], "flow": [
      { "kind": "jsonDeserialize", "name": "Parse", "jsonString": "Json", "dataType": "List of OrderRow" },
      { "kind": "forEach", "name": "EachRow", "recordList": "Parse.Data", "cycle": "Add", "next": "End" },
      { "kind": "assign", "name": "Add", "assign": { "Sum": "Sum + Parse.Data.Current.Value" }, "next": "EachRow" },
      { "kind": "exceptionHandler", "name": "OnError", "exception": "AllExceptions", "abortTransaction": false },
      { "kind": "assign", "name": "Zero", "assign": { "Sum": "0" } } ] }] } },
