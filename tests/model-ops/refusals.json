[
  { "name": "remove-existing-attribute", "where": "apply", "expect": "(rule 2)",
    "spec": { "edits": [{ "op": "remove", "element": "Customer/Email" }] } },
  { "name": "remove-existing-action", "where": "apply", "expect": "server action 'Helper' was deleted",
    "spec": { "edits": [{ "op": "remove", "element": "Helper" }] } },
  { "name": "set-wrong-type", "where": "apply", "expect": "not a IStructure",
    "spec": { "edits": [{ "op": "set", "element": "Customer", "type": "IStructure", "properties": { "Description": "x" } }] } },
  { "name": "set-unknown-member", "where": "apply", "expect": "Closest: Description",
    "spec": { "edits": [{ "op": "set", "element": "Customer", "properties": { "Descripton": "x" } }] } },
  { "name": "set-unknown-member-check", "where": "check", "expect": "Closest: Description",
    "spec": { "edits": [{ "op": "set", "element": "Customer", "type": "IEntity", "properties": { "Descripton": "x" } }] } },
  { "name": "add-bad-enum", "where": "check", "expect": "is not a IsMultiTenant value",
    "spec": { "edits": [{ "op": "add", "type": "IServerEntity", "name": "Note", "properties": { "IsMultiTenant": "Maybe" } }] } },
  { "name": "add-bad-enum-apply", "where": "apply", "expect": "is not a IsMultiTenant value",
    "spec": { "edits": [{ "op": "add", "type": "IServerEntity", "name": "Note", "properties": { "IsMultiTenant": "Maybe" } }] } },
  { "name": "set-existing-attribute-shorter", "where": "apply", "expect": "shorter length 100 -> 50",
    "spec": { "edits": [{ "op": "set", "element": "Customer/Name", "type": "IEntityAttribute", "properties": { "Length": 50 } }] } },
  { "name": "set-existing-attribute-type", "where": "apply", "expect": "(rule 2)",
    "spec": { "edits": [{ "op": "set", "element": "Customer/Score", "type": "IEntityAttribute", "properties": { "DataType": "Text" } }] } },
  { "name": "add-unknown-type", "where": "check", "expect": "Closest: IEntityAttribute",
    "spec": { "edits": [{ "op": "add", "parent": "Customer", "type": "IEntityAtribute", "name": "X" }] } },
  { "name": "add-wrong-parent", "where": "apply", "expect": "at one of those",
    "spec": { "edits": [{ "op": "add", "parent": "Helper", "type": "IEntityAttribute", "name": "X" }] } },
  { "name": "set-bad-number", "where": "check", "expect": "takes a whole number",
    "spec": { "edits": [{ "op": "set", "element": "Helper", "type": "IServerAction", "properties": { "CacheInMinutes": "five" } }] } },
  { "name": "add-taken-name", "where": "apply", "expect": "Email",
    "spec": { "edits": [{ "op": "add", "parent": "Customer", "type": "IEntityAttribute", "name": "Email" }] } },
  { "name": "move-unknown-sibling", "where": "apply", "expect": "no sibling named 'Nope'",
    "spec": { "edits": [{ "op": "move", "element": "Customer/Email", "before": "Nope" }] } },
  { "name": "add-record-without-values", "where": "apply", "expect": "Required Property Value",
    "spec": { "edits": [{ "op": "add", "parent": "Status", "type": "IRecord", "name": "Pending" }] } },
  { "name": "rename-existing-attribute", "where": "apply", "expect": "(rule 2)",
    "spec": { "edits": [{ "op": "set", "element": "Customer/Score", "type": "IEntityAttribute", "properties": { "Name": "Points" } }] } }
]
