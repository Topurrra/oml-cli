       "name": "Rows",
       "type": "Integer"
      }
     ],
     "flow": [
      {
       "kind": "sql",
       "name": "AllCustomers",
       "sql": "SELECT {Customer}.* FROM {Customer}",
       "outputs": [
        "Customer"
       ]
      },
      {
       "kind": "aggregate",
       "name": "AllOrders",
       "sources": [
        "Order"
       ]
      },
      {
       "kind": "assign",
       "name": "CountRows",
       "assign": {
        "Rows": "AllCustomers.List.Length + AllOrders.List.Length"
       }
      }
     ]
    }
   ],
   "widgets": [
    {
     "type": "Expression",
     "value": "GetAll.Count"
    },
    {
     "type": "Expression",
     "value": "LoadSql.Rows"
    }
   ]
  },
