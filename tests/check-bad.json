  {
   "name": "LoopQuery",
   "public": true,
   "description": "Query in a loop.",
   "outputs": [
    {
     "name": "Total",
     "type": "Decimal",
     "description": "Sum."
    }
   ],
   "flow": [
    {
     "kind": "aggregate",
     "name": "GetCustomers",
     "sources": [
      "Customer"
     ],
     "maxRecords": 10
    },
    {
     "kind": "forEach",
     "name": "Outer",
     "recordList": "GetCustomers.List",
     "cycle": "Inner",
     "next": "End"
    },
    {
     "kind": "forEach",
     "name": "Inner",
     "recordList": "GetCustomers.List",
     "cycle": "GetOrders",
     "next": "Outer"
    },
    {
     "kind": "aggregate",
     "name": "GetOrders",
     "sources": [
      "Order"
     ],
     "filters": [
      "Order.CustomerId = GetCustomers.List.Current.Customer.Id"
     ],
     "maxRecords": 5
    },
    {
     "kind": "assign",
     "name": "Add",
     "assign": {
      "Total": "Total + GetOrders.List.Current.Order.Total"
     },
     "next": "Inner"
    }
   ]
  },
  {
   "name": "InlineSearch",
   "public": true,
   "description": "Inline SQL fed by an input.",
   "inputs": [
    {
     "name": "Filter",
     "description": "SQL condition."
    }
   ],
   "outputs": [
    {
     "name": "Count",
     "type": "Integer",
     "description": "Rows."
    }
   ],
   "flow": [
    {
     "kind": "sql",
     "name": "Search",
     "sql": "SELECT {Customer}.* FROM {Customer} WHERE @Condition",
     "params": [
      {
       "name": "Condition",
       "value": "\"(\" + Filter + \")\"",
       "expandInline": true
      }
     ],
     "outputs": [
      "Customer"
     ],
     "maxRecords": 10
    },
    {
     "kind": "assign",
     "name": "CountRows",
     "assign": {
      "Count": "Search.List.Length"
     }
    }
   ]
  },
