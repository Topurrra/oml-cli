  {
   "name": "UnusedQuery",
   "public": true,
   "description": "Reads data it never uses.",
   "flow": [
    {
     "kind": "aggregate",
     "name": "GetIgnored",
     "sources": [
      "Customer"
     ],
     "maxRecords": 1
    }
   ]
  },
