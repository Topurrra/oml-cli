 "clientActions": [
  {
   "name": "ClientLoop",
   "public": true,
   "description": "Server call in a loop.",
   "locals": [
    {
     "name": "Numbers",
     "type": "List of Integer"
    }
   ],
   "flow": [
    {
     "kind": "forEach",
     "name": "Each",
     "recordList": "Numbers",
     "cycle": "Ping",
     "next": "End"
    },
    {
     "kind": "execute",
     "action": "Ping",
     "next": "Each"
    }
   ]
  },
  {
   "name": "ClientTwice",
   "public": true,
   "description": "Two server calls.",
   "flow": [
    {
     "kind": "execute",
     "name": "Ping1",
     "action": "Ping"
    },
    {
     "kind": "execute",
     "name": "Ping2",
     "action": "Ping"
    }
   ]
  },
  {
   "name": "ClientUser",
   "public": true,
   "description": "Sends the user from the client.",
   "locals": [
    {
     "name": "Me",
     "type": "User Identifier"
    }
   ],
   "flow": [
    {
     "kind": "assign",
     "name": "Remember",
     "assign": {
      "Me": "GetUserId()"
     }
    },
    {
     "kind": "execute",
     "action": "ForUser",
     "args": {
      "UserId": "Me"
     }
    }
   ]
  }
