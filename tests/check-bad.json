  {
   "name": "Nested",
   "public": true,
   "description": "Nesting sample.",
   "inputs": [
    {
     "name": "N",
     "type": "Integer",
     "description": "Level."
    }
   ],
   "outputs": [
    {
     "name": "R",
     "type": "Integer",
     "description": "Result."
    }
   ],
   "flow": [
    {
     "kind": "if",
     "name": "If1",
     "condition": "N > 1",
     "true": "If2",
     "false": "Join"
    },
    {
     "kind": "if",
     "name": "If2",
     "condition": "N > 2",
     "true": "If3",
     "false": "Join"
    },
    {
     "kind": "if",
     "name": "If3",
     "condition": "N > 3",
     "true": "If4",
     "false": "Join"
    },
    {
     "kind": "if",
     "name": "If4",
     "condition": "N > 4",
     "true": "If5",
     "false": "Join"
    },
    {
     "kind": "if",
     "name": "If5",
     "condition": "N > 5",
     "true": "Deep",
     "false": "Join"
    },
    {
     "kind": "assign",
     "name": "Deep",
     "assign": {
      "R": "5"
     },
     "next": "Join"
    },
    {
     "kind": "assign",
     "name": "Join",
     "assign": {
      "R": "R + 1"
     },
     "next": "End"
    }
   ]
  },
