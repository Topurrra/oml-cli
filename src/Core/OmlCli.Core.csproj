<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Service Studio's own assemblies disagree on library versions at compile time; at run time the
         launcher's load context resolves them, so the conflict warning is noise. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <SS Condition="'$(SS)' == ''">C:\Program Files\OutSystems\Service Studio 11\Service Studio</SS>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Architecture\template.html" LogicalName="OmlCli.Architecture.template.html" />
    <EmbeddedResource Include="Check\template.html" LogicalName="OmlCli.Check.template.html" />
    <EmbeddedResource Include="Review\template.html" LogicalName="OmlCli.Review.template.html" />
    <Compile Include="..\JsonOutput.cs" Link="JsonOutput.cs" />
    <Compile Include="..\AssetFiles.cs" Link="AssetFiles.cs" />
    <Compile Include="..\Locations.cs" Link="Locations.cs" />
    <Compile Include="..\UsageLog.cs" Link="UsageLog.cs" />
    <!-- The human terminal view: compiled into Core too, so every command's output can use it. -->
    <Compile Include="..\Terminal\*.cs" Link="Terminal\%(Filename)%(Extension)" />
    <!-- Validation message hints in apply and validate reports; the same file `oml warn` prints. -->
    <Compile Include="..\WarningTable.cs" Link="WarningTable.cs" />
    <!-- The search engine of oml doc search; oml find text ranks a module's elements with it. -->
    <Compile Include="..\Search.cs" Link="Search.cs" />
    <Compile Include="..\SearchGlossary.cs" Link="SearchGlossary.cs" />
    <EmbeddedResource Include="..\..\skill\reference\warnings.md" LogicalName="OmlCli.doc.warnings.md" />
    <!-- Compile-time only. At run time every one of these, and whatever they depend on,
         comes from the installed Service Studio through the launcher's load context. -->
    <Reference Include="$(SS)\OutSystems.Model.V1.dll" Private="false" />
    <Reference Include="$(SS)\SkiaSharp.dll" Private="false" />
    <Reference Include="$(SS)\Svg.Skia.dll" Private="false" />
    <Reference Include="$(SS)\Svg.Model.dll" Private="false" />
    <Reference Include="$(SS)\ShimSkiaSharp.dll" Private="false" />
    <Reference Include="$(SS)\ServiceStudio.PluginAPI.dll" Private="false" />
    <Reference Include="$(SS)\ServiceStudio.Framework.dll" Private="false" />
    <Reference Include="$(SS)\ServiceStudio.Common.dll" Private="false" />
    <Reference Include="$(SS)\OutSystems.Model.Plugins.dll" Private="false" />
    <Reference Include="$(SS)\Plugins\ServiceStudio\ServiceStudio.Plugin.NRWidgets.dll" Private="false" />
    <Reference Include="$(SS)\Plugins\ServiceStudio\ServiceStudio.Plugin.RESTService.dll" Private="false" />
  </ItemGroup>
</Project>
