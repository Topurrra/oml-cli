<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on the newest installed .NET, so a Service Studio that moves to a newer runtime still loads. -->
    <RollForward>LatestMajor</RollForward>
    <!-- A command runs once and is short: dynamic PGO only adds JIT work. Measured 7 to 18 percent faster without it. -->
    <TieredPGO>false</TieredPGO>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>oml</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Core\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built and copied next to oml.exe, but never loaded by the default context (see Program.cs). -->
    <ProjectReference Include="Core\OmlCli.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- No model types: the launcher uses it to check the input of a check with a team before it downloads anything. -->
    <Compile Include="Core\CheckCatalog.cs" Link="CheckCatalog.cs" />
    <!-- No model types: the usage text, for the help of the commands the launcher runs itself. -->
    <Compile Include="Core\CliUsage.cs" Link="CliUsage.cs" />
    <!-- No model types: `oml spec check` resolves {"file": ...} spec values as apply does. -->
    <Compile Include="Core\SpecFiles.cs" Link="SpecFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- `oml spec` prints sections of spec.md; embedding it keeps it working from a release zip. -->
    <EmbeddedResource Include="..\skill\reference\spec.md" LogicalName="OmlCli.spec.md" />
    <!-- `oml doc <topic>` and `oml warn`: the knowledge files for agents, one topic each. -->
    <EmbeddedResource Include="..\skill\reference\best-practices.md;..\skill\reference\ui-reactive.md;..\skill\reference\osui-patterns.md;..\skill\reference\data-rules.md;..\skill\reference\logic-rules.md;..\skill\reference\security.md;..\skill\reference\rest.md;..\skill\reference\processes-timers-email.md;..\skill\reference\architecture-rules.md;..\skill\reference\warnings.md;..\skill\reference\traditional-to-reactive.md;..\skill\reference\troubleshooting.md;..\skill\reference\ui-checklist.md;..\skill\reference\testing.md;..\skill\reference\memory.md" LogicalName="OmlCli.doc.%(Filename)%(Extension)" />
    <!-- `oml dashboard`: its page, and the skill pages it shows (the UI checklist is the doc topic above). -->
    <EmbeddedResource Include="Dashboard\web\*" LogicalName="OmlCli.web.%(Filename)%(Extension)" />
    <!-- Also the doc topic `oml doc rules` (DocCommand). -->
    <EmbeddedResource Include="..\skill\rules.md" LogicalName="OmlCli.rules.md" />
    <EmbeddedResource Include="..\skill\recipes\*.jsonc" LogicalName="OmlCli.recipes.%(Filename)%(Extension)" />
    <!-- Double-click shortcut that starts `oml dashboard`. -->
    <None Include="oml-dashboard.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
