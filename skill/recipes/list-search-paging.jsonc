// Build a Reactive list screen with a search box, a sorted aggregate, Previous/Next paging and an empty state.
// Base: a copy of your Reactive module with LayoutTopMenu and a handler. Rename Customer, Customers and the attributes together.
// Related keys: aggregates (filters, sorts, maxRecords, startIndex), locals, refreshData, onChange, enabled, If.
// The sort is fixed in the aggregate. The search matches part of the name; change the filter for other fields.
// With OutSystems UI, replace the Pager container by its Pagination block and handle its OnNavigate event:
//   { "type": "BlockInstance", "sourceBlock": "OutSystemsUI.Pagination", "args": { "StartIndex": "StartIndex", "MaxRecords": "PageSize",
//     "TotalCount": "LongIntegerToInteger(FetchCustomers.Count)" }, "events": { "OnNavigate": "GoToPage" } }
//   and a screen action GoToPage with input NewStartIndex (Integer): assign StartIndex = NewStartIndex, then refreshData.
{
  "entities": [{ "name": "Customer", "attributes": [
    { "name": "Name", "length": 100, "mandatory": true },
    { "name": "City", "length": 100 }
  ] }],
  "screens": [{ "name": "Customers", "layout": "LayoutTopMenu", "access": { "anonymous": false, "registered": true },
    "title": [{ "type": "Text", "text": "Customers" }],
    "locals": [
      { "name": "SearchText", "type": "Text" },
      { "name": "StartIndex", "type": "Integer", "default": "0" },
      { "name": "PageSize", "type": "Integer", "default": "10" }
    ],
    "aggregates": [{ "name": "FetchCustomers", "sources": ["Customer"],
      "filters": ["Customer.Name like \"%\" + SearchText + \"%\""],
      "sorts": [{ "attribute": "Customer.Name" }],
      "maxRecords": "PageSize", "startIndex": "StartIndex" }],
    "actions": [
      { "name": "Search", "flow": [
        { "kind": "assign", "name": "FirstPage", "assign": { "StartIndex": "0" } },
        { "kind": "refreshData", "name": "Reload", "dataSource": "FetchCustomers" }
      ] },
      { "name": "PreviousPage", "flow": [
        { "kind": "assign", "name": "Back", "assign": { "StartIndex": "Max(StartIndex - PageSize, 0)" } },
        { "kind": "refreshData", "name": "Reload", "dataSource": "FetchCustomers" }
      ] },
      { "name": "NextPage", "flow": [
        { "kind": "assign", "name": "Forward", "assign": { "StartIndex": "StartIndex + PageSize" } },
        { "kind": "refreshData", "name": "Reload", "dataSource": "FetchCustomers" }
      ] }
    ],
    "widgets": [
      { "type": "Input", "name": "SearchInput", "variable": "SearchText", "prompt": "\"Search by name\"", "onChange": "Search" },
      { "type": "If", "condition": "FetchCustomers.List.Empty",
        "trueBranch": [{ "type": "Text", "text": "No customers match your search." }],
        "falseBranch": [{ "type": "TableRecords", "name": "CustomerTable", "source": "FetchCustomers.List", "style": "\"table\"",
          "headerRow": [
            { "type": "HeaderCell", "children": [{ "type": "Text", "text": "Name" }] },
            { "type": "HeaderCell", "children": [{ "type": "Text", "text": "City" }] }
          ],
          "row": [
            { "type": "RowCell", "children": [{ "type": "Expression", "value": "FetchCustomers.List.Current.Customer.Name" }] },
            { "type": "RowCell", "children": [{ "type": "Expression", "value": "FetchCustomers.List.Current.Customer.City" }] }
          ] }] },
      { "type": "Container", "name": "Pager", "style": "\"display-flex\"", "children": [
        { "type": "Button", "name": "PreviousButton", "onClick": "PreviousPage", "enabled": "StartIndex > 0", "style": "\"btn\"",
          "children": [{ "type": "Text", "text": "Previous" }] },
        { "type": "Button", "name": "NextButton", "onClick": "NextPage", "enabled": "FetchCustomers.List.Length = PageSize", "style": "\"btn btn-primary\"",
          "children": [{ "type": "Text", "text": "Next" }] }
      ] }
    ]
  }]
}
