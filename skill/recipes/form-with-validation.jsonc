// Build a Reactive form: client-side checks with messages, a server save that raises a user exception, and the screen handling it.
// Base: a copy of your Reactive module with LayoutTopMenu and a handler. Rename Contact, ContactForm, InvalidContact and the texts together.
// Related keys: exceptions, serverActions, raiseException, screens, locals, actions, exceptionHandler, mandatory, If with trueBranch.
// The server action repeats the checks, because client checks can be bypassed. Add attributes and checks as your entity needs.
{
  "exceptions": ["InvalidContact"],
  "entities": [{ "name": "Contact", "attributes": [
    { "name": "Name", "length": 100, "mandatory": true },
    { "name": "Email", "type": "Email", "length": 250, "mandatory": true },
    { "name": "Age", "type": "Integer" },
    { "name": "Newsletter", "type": "Boolean" }
  ] }],
  "serverActions": [{ "name": "Contact_Save",
    "inputs": [{ "name": "Contact", "type": "Contact", "mandatory": true }],
    "outputs": [{ "name": "Id", "type": "Contact Identifier" }], "flow": [
      { "kind": "if", "name": "HasName", "condition": "Trim(Contact.Name) <> \"\"", "true": "HasEmail", "false": "NameMissing" },
      { "kind": "if", "name": "HasEmail", "condition": "Index(Contact.Email, \"@\") > 0", "true": "Save", "false": "EmailInvalid" },
      { "kind": "execute", "name": "Save", "action": "CreateOrUpdateContact", "args": { "Source": "Contact" } },
      { "kind": "assign", "name": "ReturnId", "assign": { "Id": "Save.Id" }, "next": "End" },
      { "kind": "raiseException", "name": "NameMissing", "exception": "InvalidContact", "message": "\"Name is required\"" },
      { "kind": "raiseException", "name": "EmailInvalid", "exception": "InvalidContact", "message": "\"Enter a valid email address\"" }
    ] }],
  "screens": [{ "name": "ContactForm", "layout": "LayoutTopMenu", "access": { "anonymous": false, "registered": true },
    "title": [{ "type": "Text", "text": "New contact" }],
    "locals": [
      { "name": "NewContact", "type": "Contact" },
      { "name": "NameError", "type": "Text" },
      { "name": "EmailError", "type": "Text" }
    ],
    "actions": [{ "name": "Save", "flow": [
      { "kind": "assign", "name": "Check", "assign": {
        "NameError": "If(Trim(NewContact.Name) = \"\", \"Enter the contact name\", \"\")",
        "EmailError": "If(Index(NewContact.Email, \"@\") > 0, \"\", \"Enter a valid email address\")" } },
      { "kind": "if", "name": "ClientValid", "condition": "NameError = \"\" and EmailError = \"\"", "true": "SaveContact", "false": "Fix" },
      { "kind": "message", "name": "Fix", "message": "\"Fix the highlighted fields\"", "type": "warning", "next": "End" },
      { "kind": "execute", "name": "SaveContact", "action": "Contact_Save", "args": { "Contact": "NewContact" } },
      { "kind": "message", "name": "Saved", "message": "\"Contact saved\"", "type": "success", "next": "End" },
      { "kind": "exceptionHandler", "name": "OnInvalidContact", "exception": "InvalidContact" },
      { "kind": "message", "name": "ShowServerError", "message": "OnInvalidContact.ExceptionMessage", "type": "error" }
    ] }],
    "widgets": [{ "type": "Form", "name": "ContactFormBody", "style": "\"card padding-m\"", "children": [
      { "type": "Label", "children": [{ "type": "Text", "text": "Name" }] },
      { "type": "Input", "name": "NameInput", "variable": "NewContact.Name", "mandatory": "True", "maxLength": 100, "prompt": "\"Full name\"", "style": "If(NameError = \"\", \"form-control\", \"form-control not-valid\")" },
      { "type": "If", "condition": "NameError <> \"\"", "trueBranch": [{ "type": "Container", "style": "\"validation-message\"", "children": [{ "type": "Expression", "value": "NameError" }] }] },
      { "type": "Label", "children": [{ "type": "Text", "text": "Email" }] },
      { "type": "Input", "name": "EmailInput", "variable": "NewContact.Email", "mandatory": "True", "inputType": "Email", "maxLength": 250, "prompt": "\"name@example.com\"", "style": "If(EmailError = \"\", \"form-control\", \"form-control not-valid\")" },
      { "type": "If", "condition": "EmailError <> \"\"", "trueBranch": [{ "type": "Container", "style": "\"validation-message\"", "children": [{ "type": "Expression", "value": "EmailError" }] }] },
      { "type": "Label", "children": [{ "type": "Text", "text": "Age" }] },
      { "type": "Input", "name": "AgeInput", "variable": "NewContact.Age", "inputType": "Number", "prompt": "\"Optional\"" },
      { "type": "Checkbox", "name": "NewsletterInput", "variable": "NewContact.Newsletter" },
      { "type": "Label", "children": [{ "type": "Text", "text": "Send me the newsletter" }] },
      { "type": "Button", "onClick": "Save", "style": "\"btn btn-primary\"", "children": [{ "type": "Text", "text": "Save contact" }] }
    ] }]
  }]
}
