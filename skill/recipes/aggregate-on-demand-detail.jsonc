// Build a Reactive master-detail screen: the customer list loads at start, the order list only when a customer is picked.
// Base: a copy of your Reactive module with LayoutTopMenu and a handler. Rename Customer, Order, Customers and the attributes together.
// Related keys: aggregates (fetch, filters, sorts, maxRecords), refreshData, onClick with args, If.
// An onDemand aggregate runs only on refreshData; without one the model warns. Its filter reads the screen local SelectedId.
{
  "entities": [
    { "name": "Customer", "attributes": [{ "name": "Name", "length": 100, "mandatory": true }] },
    { "name": "Order", "attributes": [
      { "name": "CustomerId", "type": "Customer Identifier", "mandatory": true },
      { "name": "PlacedOn", "type": "Date" },
      { "name": "Total", "type": "Decimal", "length": 37, "decimals": 2 }
    ], "indexes": [{ "attributes": ["CustomerId", "PlacedOn"] }] }
  ],
  "screens": [{ "name": "CustomerOrders", "layout": "LayoutTopMenu", "access": { "anonymous": false, "registered": true },
    "title": [{ "type": "Text", "text": "Customer orders" }],
    "locals": [{ "name": "SelectedId", "type": "Customer Identifier" }],
    "aggregates": [
      { "name": "FetchCustomers", "sources": ["Customer"], "sorts": [{ "attribute": "Customer.Name" }], "maxRecords": 50 },
      { "name": "FetchOrders", "fetch": "onDemand", "sources": ["Order"],
        "filters": ["Order.CustomerId = SelectedId"], "sorts": [{ "attribute": "Order.PlacedOn", "descending": true }], "maxRecords": 100 }
    ],
    "actions": [{ "name": "SelectCustomer", "inputs": [{ "name": "CustomerId", "type": "Customer Identifier", "mandatory": true }], "flow": [
      { "kind": "assign", "name": "Remember", "assign": { "SelectedId": "CustomerId" } },
      { "kind": "refreshData", "name": "LoadOrders", "dataSource": "FetchOrders" }
    ] }],
    "widgets": [
      { "type": "TableRecords", "name": "CustomerTable", "source": "FetchCustomers.List", "style": "\"table\"",
        "headerRow": [{ "type": "HeaderCell", "children": [{ "type": "Text", "text": "Customer" }] }],
        "row": [{ "type": "RowCell", "children": [
          { "type": "Link", "onClick": "SelectCustomer", "args": { "CustomerId": "FetchCustomers.List.Current.Customer.Id" },
            "children": [{ "type": "Expression", "value": "FetchCustomers.List.Current.Customer.Name" }] } ] }] },
      { "type": "If", "name": "HasSelection", "condition": "SelectedId = NullIdentifier()",
        "trueBranch": [{ "type": "Text", "text": "Pick a customer to see the orders." }],
        "falseBranch": [{ "type": "TableRecords", "name": "OrderTable", "source": "FetchOrders.List", "style": "\"table\"",
          "headerRow": [
            { "type": "HeaderCell", "children": [{ "type": "Text", "text": "Date" }] },
            { "type": "HeaderCell", "children": [{ "type": "Text", "text": "Total" }] }
          ],
          "row": [
            { "type": "RowCell", "children": [{ "type": "Expression", "value": "FetchOrders.List.Current.Order.PlacedOn" }] },
            { "type": "RowCell", "children": [{ "type": "Expression", "value": "FetchOrders.List.Current.Order.Total" }] }
          ] }] }
    ]
  }]
}
